{
  "name": "@ai-estimate-studio/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ai-estimate-studio/application": "workspace:*",
    "@ai-estimate-studio/domain": "workspace:*",
    "@ai-estimate-studio/pricing-engine": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "db:format": "prisma format --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "test:integration": "vitest run src/repositories/catalog.integration.test.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
